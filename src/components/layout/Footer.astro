---
import { SITE_CONFIG } from '@/config/site';
import InstagramIcon from '@/assets/instagram.svg';
import SoundcloudIcon from '@/assets/soundcloud.svg';
import WhatsappIcon from '@/assets/whatsapp.svg';

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    href: SITE_CONFIG.social.instagram,
    label: 'Instagram',
    icon: InstagramIcon,
  },
  { href: SITE_CONFIG.social.whatsapp, label: 'WhatsApp', icon: WhatsappIcon },
  {
    href: SITE_CONFIG.social.soundcloud,
    label: 'SoundCloud',
    icon: SoundcloudIcon,
  },
];
---

<footer class="border-t border-gray-800 bg-black py-12">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center gap-8">
      <a
        href="/"
        class="font-display text-2xl font-bold tracking-wider text-white"
      >
        DJ LABØ
      </a>

      <div class="flex gap-6">
        {
          socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 transition-colors hover:text-primary"
              aria-label={link.label}
            >
              <link.icon class="size-6" />
            </a>
          ))
        }
      </div>

      <p class="text-sm text-gray-500">
        © {currentYear} DJ LABØ. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
